# --- Model selection (provider-agnostic) ---
#
# 'provider:model-name', passed straight to langchain's init_chat_model.
# Default is Anthropic; set to e.g. "openai:gpt-5.1" to demonstrate this
# harness is not Anthropic-specific. See README "Model-agnostic by config".
AGENT_MODEL=anthropic:claude-sonnet-4-6

# Exactly one of these must be set, matching AGENT_MODEL's provider.
# Deployment-wide secrets, read from this process's own os.environ by the
# harness process itself at startup -- NOT per-request identity (see
# MORPHEUS_ACCESS_TOKEN-equivalent note below).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- CLI environment ---
#
# The cybersierra CLI must already be installed (npm i -g
# @cybersierra/cybersierra-cli).
#
# CYBERSIERRA_BASE_URL is read by this harness and translated into
# MORPHEUS_BASE_URL -- the variable name the real CLI's own profile
# resolution actually checks -- injected into every sandboxed subprocess
# call, UNCONDITIONALLY (deployment-wide config, not gated behind
# CYBERSIERRA_INJECT_ACCESS_TOKEN, since it's the same value for every user,
# not per-request secret data). This is what a real deployment actually
# needs: set this + CYBERSIERRA_INJECT_ACCESS_TOKEN=1 below + the tracy
# service-auth secret in server/app.py's config, and no human ever needs to
# run any interactive `cybersierra auth` command on this server's host, on
# a genuinely fresh box or otherwise -- confirmed live, see README
# "Authentication model".
#
# Leave this UNSET only for the bundled frontend/index.html local-dev test
# page (a single developer's own machine, not a real deployment) -- that
# path intentionally still depends on a one-time `cybersierra auth
# login-browser --url ...` run manually on that one dev machine, with the
# CLI's own persisted profile (~/.cybersierra/config.json) supplying the
# base URL instead.
CYBERSIERRA_BASE_URL=https://morpheus-api.prod.cybersierra.ai/

# --- Per-request identity ---
#
# access_token is an OPTIONAL field on every POST /chat call -- unlike the
# sibling Claude SDK POC's SSE contract, missing/empty does NOT 400 here
# (the `no_token` check was deliberately dropped; see README
# "Authentication model" for why). It is never read from this process's
# own os.environ regardless of the setting below -- always supplied
# per-request from the caller.
#
# CYBERSIERRA_INJECT_ACCESS_TOKEN (default: off/unset) controls what that
# access_token is actually USED for by the cybersierra CLI calls this
# harness makes:
#
#   unset (default) -- access_token, even if sent, is ignored. cybersierra
#     CLI calls use whatever profile the one-time `cybersierra auth
#     login-browser` already established (see "CLI environment" above) --
#     matching this POC's "assume already authenticated" default.
#
#   =1 -- access_token IS injected fresh, per subprocess call, as
#     MORPHEUS_TOKEN -- confirmed live against the actual installed CLI
#     binary (not just this repo's own prior, incorrect docs, which
#     claimed CYBERSIERRA_TOKEN -- that name is never read by the real
#     CLI at all) to override the CLI's persisted profile with zero
#     ambient leakage. For this to actually work, every request's access_token must be a
#     real per-user cybersierra JWT, not a placeholder -- a wrong value
#     here is WORSE than not setting this at all, since it overrides an
#     already-working login with something the real backend will reject.
#     This is the mechanism a real shape-B/C multi-tenant deployment
#     needs -- set it to 1 for the morpheus_backend integration (which
#     forwards the requesting user's real FusionAuth JWT as access_token
#     on every call), leave it off for standalone/demo use.
CYBERSIERRA_INJECT_ACCESS_TOKEN=

# --- Service-to-service auth (morpheus_backend -> this server) ---
#
# A single shared secret morpheus_backend must send as the X-Service-Auth
# header on every POST /chat call. Fails closed: unset here means every
# caller is refused (401), not that the check is skipped -- /chat executes
# real CLI commands, so this must never be left open beyond a single
# developer's own machine. Generate any sufficiently random string; the
# exact same value must also be configured on morpheus_backend's side
# (its own DEEPAGENT_SERVICE_AUTH env var).
DEEPAGENT_SERVICE_AUTH=

# --- Netra observability (optional) ---
#
# Off by default. Set NETRA_TRACING=1 and NETRA_API_KEY to enable span/trace
# export (cli_call / Plan_Step / Agent_Turn spans, see harness/tracing.py).
# If netra-sdk isn't installed, or these aren't set, every span call becomes
# a no-op -- there is no behavior difference, only missing telemetry.
#
# NETRA_OTLP_ENDPOINT is also required to actually reach Netra's collector:
# without it, netra-sdk silently falls back to a ConsoleSpanExporter (spans
# print to stdout, nothing shows up on the Netra dashboard). Same value used
# by the sibling cybersierra-ai-agents repo's .env.example.
NETRA_TRACING=false
NETRA_API_KEY=
NETRA_TRACE_CONTENT=false
NETRA_OTLP_ENDPOINT=https://api.netra.dev.cybersierra.ai/telemetry

# --- Netra eval framework (see eval/README.md) ---
#
# eval/local/* and eval/netra/run.py (the direct-service Netra track) need
# none of this -- only NETRA_API_KEY/NETRA_OTLP_ENDPOINT/NETRA_TRACING above.
# MORPHEUS_BACKEND_URL/DEEPAGENT_CHAT_PROXY_PATH/EVAL_MORPHEUS_* below are
# ONLY for eval/netra/run_via_production_hop.py -- the parked production-hop
# path (2a), which tests the real morpheus_backend -> deepagent request path
# rather than this service directly. That path is currently blocked (nobody
# has provisioned a dedicated eval tenant) -- see eval/README.md's "Two
# things both called 'the Netra track'".
MORPHEUS_BACKEND_URL=
DEEPAGENT_CHAT_PROXY_PATH=/tracy/chat

# A dedicated eval test tenant/user (not a real user's account) -- MFA MUST
# be disabled, since run_via_production_hop.py's scripted login can't
# complete a two-factor challenge (see B0 in the original v2 plan; not
# automated -- create this once by hand in morpheus).
EVAL_MORPHEUS_EMAIL=
EVAL_MORPHEUS_PASSWORD=
EVAL_MORPHEUS_ORG=

# --- Chat server CORS ---
#
# Comma-separated list of browser origins allowed to call POST /chat and
# GET /health. As of the morpheus_backend integration, morpheus_fe no
# longer calls this server directly from the browser (it goes through
# morpheus_backend's /tracy/chat proxy instead, which is same-origin from
# morpheus_fe's point of view and governed by morpheus_backend's own CORS
# config, not this one). This setting now only matters for the bundled
# frontend/index.html test UI (already same-origin, unaffected either way)
# and any ad hoc local browser testing directly against this server.
# Falls back to http://localhost:8000 if unset.
FRONTEND_ORIGINS=http://localhost:8000
